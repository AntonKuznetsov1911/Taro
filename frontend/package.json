{
  "name": "taro-tarot-app",
  "main": "expo-router/entry",
  "version": "1.4.1",
  "homepage": "https://antonkuznetsov1911.github.io/Taro",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export -p web && node scripts/inject-pwa.js && node scripts/copy-mediapipe.js",
    "build:gh-pages": "GITHUB_PAGES=true expo export -p web && node scripts/inject-pwa.js && node scripts/copy-mediapipe.js && cp dist/index.html dist/404.html && touch dist/.nojekyll",
    "predeploy": "npm run build:gh-pages",
    "postbuild": "node scripts/inject-pwa.js",
    "deploy": "gh-pages -d dist --dotfiles --nojekyll --no-history",
    "test": "jest --watchAll",
    "typecheck": "tsc --noEmit",
    "test:unit": "jest --runInBand --watchAll=false --passWithNoTests",
    "prebuild:android": "expo prebuild --platform android --no-install"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@mediapipe/tasks-vision": "^0.10.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^7.1.8",
    "astronomy-engine": "^2.1.19",
    "base64-js": "^1.5.1",
    "expo": "~54.0.38",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.14",
    "expo-audio": "~1.1.1",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.20",
    "expo-web-browser": "~15.0.11",
    "html2canvas": "1.4.1",
    "onnxruntime-web": "^1.30.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "^19.1.0",
    "gh-pages": "^6.3.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
